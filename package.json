{
  "name": "researchos",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "preview": "node scripts/serve.mjs",
    "test": "npm run build && node scripts/test-bundle.mjs && node .test-build/suite.mjs",
    "test:unit": "npm run build && node scripts/test-bundle.mjs && node .test-build/suite.mjs",
    "test:integration": "npm run build && node scripts/test-bundle.mjs && node .test-build/suite.mjs",
    "seed:export": "npm run build && node scripts/export-seed.mjs",
    "content:audit": "npm run build && node scripts/content-audit.mjs",
    "performance:audit": "npm run build && node scripts/performance-audit.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^5.4.54",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "rollup": "^4.49.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
